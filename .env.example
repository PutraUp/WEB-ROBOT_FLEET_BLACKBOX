# ==============================================================================
# Robot Fleet Black Box - Environment Configuration Template
# ==============================================================================
# CATATAN KRIPTOGRAFI TUGAS 2 (RUBRIK K3 - PENYIMPANAN KUNCI DI LUAR REPOSITORI):
# File ini HANYALAH TEMPLATE. Kunci simetris ASLI TIDAK BOLEH dikomit ke Git!
# Salin berkas ini menjadi '.env.local' lalu isi dengan kunci hex 256-bit (64 karakter hex)
# yang dibangkitkan menggunakan CSPRNG (Cryptographically Secure Pseudo-Random Number Generator).
# ==============================================================================

# Kunci Master Simetris AEAD AES-256-GCM (256-bit / 32 bytes = 64 karakter heksadesimal)
# Bangkitkan dengan perintah: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AEAD_MASTER_KEY_HEX=

# Nama Node Operasional Gudang
NEXT_PUBLIC_FACILITY_NODE=JKT-LOGISTICS-HUB-01

# Akun demo autentikasi Modul 5 (tanpa nilai asli)
DEMO_EMAIL=
DEMO_KATA_SANDI=
